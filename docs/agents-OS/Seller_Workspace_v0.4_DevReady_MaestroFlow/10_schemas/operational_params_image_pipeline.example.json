{
  "imageCount": {
    "min": 1,
    "max": 9,
    "default": 4
  },
  "provider": {
    "default": "gpt-image"
  },
  "timeoutSeconds": 300,
  "retry": {
    "max": 1
  },
  "progressStages": [
    {
      "stage": "queued",
      "progress": 0,
      "label": "已创建任务"
    },
    {
      "stage": "validating",
      "progress": 10,
      "label": "正在检查素材与参数"
    },
    {
      "stage": "preparing_context",
      "progress": 20,
      "label": "正在准备任务上下文"
    },
    {
      "stage": "generating_prompt",
      "progress": 35,
      "label": "正在准备生成方案"
    },
    {
      "stage": "calling_provider",
      "progress": 55,
      "label": "正在生成图片"
    },
    {
      "stage": "post_processing",
      "progress": 80,
      "label": "正在整理结果"
    },
    {
      "stage": "saving_results",
      "progress": 90,
      "label": "正在保存结果"
    },
    {
      "stage": "succeeded",
      "progress": 100,
      "label": "已完成"
    }
  ]
}
