{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "image_pipeline parameters",
  "type": "object",
  "required": [
    "productName",
    "category",
    "outputMode",
    "style",
    "imageCount"
  ],
  "properties": {
    "productName": {
      "type": "string",
      "title": "商品名称",
      "minLength": 1
    },
    "sku": {
      "type": "string",
      "title": "SKU",
      "default": "unknown"
    },
    "category": {
      "type": "string",
      "title": "商品类目"
    },
    "platform": {
      "type": "string",
      "title": "平台",
      "enum": [
        "general",
        "amazon",
        "xiaohongshu",
        "taobao",
        "tiktok"
      ],
      "default": "general"
    },
    "outputMode": {
      "type": "string",
      "title": "输出类型",
      "enum": [
        "main_image",
        "detail_image",
        "scene_image",
        "selling_point",
        "set"
      ],
      "default": "detail_image"
    },
    "style": {
      "type": "string",
      "title": "风格",
      "enum": [
        "高级感",
        "极简",
        "真实电商",
        "小红书风",
        "亚马逊白底",
        "生活方式场景"
      ],
      "default": "真实电商"
    },
    "imageCount": {
      "type": "integer",
      "title": "生成数量",
      "minimum": 1,
      "maximum": 9,
      "default": 4
    },
    "referenceImageAssetIds": {
      "type": "array",
      "title": "参考图",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "title": "补充要求"
    }
  },
  "additionalProperties": false
}
